{
  "version": 3,
  "configurePresets": [
    {
      "name": "default",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/longqiu/${presetName}",
      "toolchainFile": "${sourceDir}/cmake/gcc-arm-none-eabi.cmake",
      "cacheVariables": {
        "FOC_PORT": "M1",
        "FOC_ENCODER": "TLE5012B",
        "FOC_MOTOR": "L4225_6S420_A",
        "FOC_LOAD_PROFILE": "FREE_SHAFT",
        "FOC_INSTALLATION_ID": "4",
        "FOC_PROTECTION": "WARN",
        "FOC_USB_DIVIDER": "2"
      }
    },
    {
      "name": "Debug",
      "inherits": "default",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug"
      }
    },
    {
      "name": "Debug-ZH3620-commission",
      "inherits": "Debug",
      "binaryDir": "${sourceDir}/build/commission-zh3620/Debug",
      "cacheVariables": {
        "FOC_MOTOR": "ZH3620_1",
        "FOC_INSTALLATION_ID": "3",
        "FOC_LOAD_PROFILE": "FREE_SHAFT"
      }
    },
    {
      "name": "Debug-installation4-commission",
      "inherits": "Debug",
      "binaryDir": "${sourceDir}/build/commission-next-motor/Debug",
      "cacheVariables": {
        "FOC_INSTALLATION_ID": "4"
      }
    },
    {
      "name": "Release",
      "inherits": "default",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      }
    },
    {
      "name": "Debug-dual-leg",
      "inherits": "Debug",
      "binaryDir": "${sourceDir}/build/dual-leg/Debug",
      "cacheVariables": {
        "FOC_DUAL_LEG": "ON",
        "FOC_PORT": "M0",
        "FOC_PROTECTION": "TRIP",
        "FOC_INSTALLATION_ID": "5",
        "FOC_ENCODER": "TLE5012B",
        "FOC_MOTOR": "L4225_6S420_A",
        "FOC_LOAD_PROFILE": "FREE_SHAFT",
        "FOC_USB_DIVIDER": "10",
        "FOC_M0_ADC_MODE": "DUAL"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "Debug-installation4-commission",
      "configurePreset": "Debug-installation4-commission"
    },
    {
      "name": "Debug-ZH3620-commission",
      "configurePreset": "Debug-ZH3620-commission"
    },
    {
      "name": "Debug",
      "configurePreset": "Debug"
    },
    {
      "name": "Release",
      "configurePreset": "Release"
    },
    {
      "name": "Debug-dual-leg",
      "configurePreset": "Debug-dual-leg"
    }
  ]
}
