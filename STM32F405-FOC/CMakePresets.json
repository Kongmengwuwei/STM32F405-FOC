{
  "version": 3,
  "configurePresets": [
    {
      "name": "default",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/longqiu/${presetName}",
      "toolchainFile": "${sourceDir}/cmake/gcc-arm-none-eabi.cmake",
      "cacheVariables": {
        "FOC_PORT": "M1",
        "FOC_ENCODER": "TLE5012B",
        "FOC_MOTOR": "L4225_6S420_A",
        "FOC_LOAD_PROFILE": "FREE_SHAFT",
        "FOC_INSTALLATION_ID": "2",
        "FOC_PROTECTION": "WARN",
        "FOC_USB_DIVIDER": "2"
      }
    },
    {
      "name": "Debug",
      "inherits": "default",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug"
      }
    },
    {
      "name": "Release",
      "inherits": "default",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "Debug",
      "configurePreset": "Debug"
    },
    {
      "name": "Release",
      "configurePreset": "Release"
    }
  ]
}
